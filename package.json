{
  "name": "onvif-server-samsung",
  "version": "2.0.0",
  "description": "Virtual ONVIF Server for Samsung legacy cameras — compatible with Dahua XVR strict ONVIF clients",
  "main": "main.js",
  "license": "MIT",
  "author": {
    "name": "Daniela Hasenbring",
    "email": "daniela@koshigaya.de"
  },
  "scripts": {
