    "test:verbose": "jest --testEnvironment=node --verbose --forceExit"
  },
  "dependencies": {
    "soap": "1.1.5",
    "xml2js": "0.4.23",
    "node-tcp-proxy": "0.0.28",
    "node-uuid": "1.4.8",
    "argparse": "2.0.1",
    "yaml": "2.5.1",
    "simple-node-logger-se": "^21.8.19"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "testMatch": ["**/test/**/*.test.js"]
  }
