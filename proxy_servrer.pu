from datetime import datetime, timezone
import re
import subprocess
from fastapi import FastAPI, Request, Response
import yaml

app = FastAPI()

with open("config.yaml", "r") as f:
    config = yaml.safe_load(f)


def get_camera_by_port(server_port: int):
    # Support both 'cameras' and 'devices' keys from YAML
    devices = config.get("cameras", config.get("devices", []))
    for cam in devices:
        if cam.get("port") == server_port:
            return cam
    return None


def extract_soap_action(body_str: str) -> str:
    tags = re.findall(r"<(?:[a-zA-Z0-9_-]+:)?([a-zA-Z0-9]+)(?:\s|>)", body_str)
    for t in tags:
        if t not in [
            "Envelope",
            "Header",
            "Body",
            "Security",
            "UsernameToken",
            "BinarySecurityToken",
            "Timestamp",
        ]:
            return t
    return "UnknownAction"


@app.get("/snapshot.jpg")
async def get_snapshot(request: Request):
    host_header = request.headers.get("host", "192.168.1.113:8080")
    port = int(host_header.split(":")[-1]) if ":" in host_header else 8080
    cam = get_camera_by_port(port)
    if not cam:
        return Response(status_code=404)

    # Support both key naming conventions
    rtsp_url = cam.get("high_quality_rtsp", cam.get("main_stream"))
    if not rtsp_url:
        return Response(status_code=500)

    cmd = [
        "ffmpeg",
        "-y",
        "-rtsp_transport",
        "tcp",
        "-i",
        rtsp_url,
        "-vframes",
        "1",
        "-f",
        "image2",
        "-",
    ]

    process = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if process.returncode != 0 or not process.stdout:
        print(f"[SNAPSHOT] FFmpeg failed on port {port}")
        return Response(status_code=500)

    return Response(content=process.stdout, media_type="image/jpeg")


@app.post("/onvif/device_service")
@app.post("/{full_path:path}")
async def handle_onvif(request: Request, full_path: str = ""):
    body = await request.body()
    body_str = body.decode("utf-8")
    action = extract_soap_action(body_str)

    host_header = request.headers.get("host", "192.168.1.113:8080")
    port = int(host_header.split(":")[-1]) if ":" in host_header else 8080
    host_ip = config.get("server_ip", "192.168.1.113")

    cam = get_camera_by_port(port)
    if not cam:
        return Response(
            content='<soap:Envelope xmlns:soap="http://www.w3.org/2003/05/soap-envelope"><soap:Body><soap:Fault><faultcode>Client</faultcode><faultstring>Camera Not Found for Port</faultstring></soap:Fault></soap:Body></soap:Envelope>',
            status_code=404,
            media_type="application/soap+xml",
        )

    cam_name = cam.get("name", f"Camera-{port}")
    hq_rtsp = cam.get("high_quality_rtsp", cam.get("main_stream"))
    lq_rtsp = cam.get("low_quality_rtsp", cam.get("sub_stream"))
    width = cam.get("width", 1920)
    height = cam.get("height", 1080)

    print(f"[ONVIF] Port {port} ({cam_name}) | Action: {action}")

    if "GetDeviceInformation" in action or "GetDeviceInformation" in body_str:
        xml_response = f"""<?xml version="1.0" encoding="utf-8"?>
<soap:Envelope xmlns:soap="http://www.w3.org/2003/05/soap-envelope" xmlns:tds="http://www.onvif.org/ver10/device/wsdl">
  <soap:Body>
    <tds:GetDeviceInformationResponse>
      <tds:Manufacturer>Custom</tds:Manufacturer>
      <tds:Model>{cam_name}</tds:Model>
      <tds:FirmwareVersion>24.12</tds:FirmwareVersion>
      <tds:SerialNumber>SN-{port}</tds:SerialNumber>
      <tds:HardwareId>HW-{port}</tds:HardwareId>
    </tds:GetDeviceInformationResponse>
  </soap:Body>
</soap:Envelope>"""

    elif "GetServices" in action or "GetServices" in body_str:
        xml_response = f"""<?xml version="1.0" encoding="utf-8"?>
<soap:Envelope xmlns:soap="http://www.w3.org/2003/05/soap-envelope" xmlns:tds="http://www.onvif.org/ver10/device/wsdl" xmlns:tt="http://www.onvif.org/ver10/schema">
  <soap:Body>
    <tds:GetServicesResponse>
      <tds:Service>
        <tds:Namespace>http://www.onvif.org/ver10/device/wsdl</tds:Namespace>
        <tds:XAddr>http://{host_ip}:{port}/onvif/device_service</tds:XAddr>
        <tt:Version><tt:Major>2</tt:Major><tt:Minor>0</tt:Minor></tt:Version>
      </tds:Service>
      <tds:Service>
        <tds:Namespace>http://www.onvif.org/ver10/media/wsdl</tds:Namespace>
        <tds:XAddr>http://{host_ip}:{port}/onvif/media_service</tds:XAddr>
        <tt:Version><tt:Major>2</tt:Major><tt:Minor>0</tt:Minor></tt:Version>
      </tds:Service>
    </tds:GetServicesResponse>
  </soap:Body>
</soap:Envelope>"""

    elif "GetServiceCapabilities" in action or "GetServiceCapabilities" in body_str:
        xml_response = """<?xml version="1.0" encoding="utf-8"?>
<soap:Envelope xmlns:soap="http://www.w3.org/2003/05/soap-envelope" xmlns:trt="http://www.onvif.org/ver10/media/wsdl" xmlns:tt="http://www.onvif.org/ver10/schema">
  <soap:Body>
    <trt:GetServiceCapabilitiesResponse>
      <trt:Capabilities SnapshotUri="true" Rotation="false" VideoSourceMode="false" OSD="false"/>
    </trt:GetServiceCapabilitiesResponse>
  </soap:Body>
</soap:Envelope>"""

    elif "GetScopes" in action or "GetScopes" in body_str:
        xml_response = f"""<?xml version="1.0" encoding="utf-8"?>
<soap:Envelope xmlns:soap="http://www.w3.org/2003/05/soap-envelope" xmlns:tds="http://www.onvif.org/ver10/device/wsdl" xmlns:tt="http://www.onvif.org/ver10/schema">
  <soap:Body>
    <tds:GetScopesResponse>
      <tds:Scopes>
        <tt:ScopeItem>onvif://www.onvif.org/type/video_encoder</tt:ScopeItem>
        <tt:ScopeItem>onvif://www.onvif.org/name/{cam_name}</tt:ScopeItem>
        <tt:ScopeItem>onvif://www.onvif.org/location/home</tt:ScopeItem>
      </tds:Scopes>
    </tds:GetScopesResponse>
  </soap:Body>
</soap:Envelope>"""

    elif "GetSystemDateAndTime" in action or "GetSystemDateAndTime" in body_str:
        now_utc = datetime.now(timezone.utc)
        xml_response = f"""<?xml version="1.0" encoding="utf-8"?>
<soap:Envelope xmlns:soap="http://www.w3.org/2003/05/soap-envelope" xmlns:tds="http://www.onvif.org/ver10/device/wsdl" xmlns:tt="http://www.onvif.org/ver10/schema">
  <soap:Body>
    <tds:GetSystemDateAndTimeResponse>
      <tds:SystemDateAndTime>
        <tt:DateTimeType>NTP</tt:DateTimeType>
        <tt:DaylightSavings>false</tt:DaylightSavings>
        <tt:TimeZone><tt:TZ>UTC</tt:TZ></tt:TimeZone>
        <tt:UTCDateTime>
          <tt:Time><tt:Hour>{now_utc.hour}</tt:Hour><tt:Minute>{now_utc.minute}</tt:Minute><tt:Second>{now_utc.second}</tt:Second></tt:Time>
          <tt:Date><tt:Year>{now_utc.year}</tt:Year><tt:Month>{now_utc.month}</tt:Month><tt:Day>{now_utc.day}</tt:Day></tt:Date>
        </tt:UTCDateTime>
      </tds:SystemDateAndTime>
    </tds:GetSystemDateAndTimeResponse>
  </soap:Body>
</soap:Envelope>"""

    elif "SetSystemDateAndTime" in action or "SetSystemDateAndTime" in body_str:
        xml_response = """<?xml version="1.0" encoding="utf-8"?>
<soap:Envelope xmlns:soap="http://www.w3.org/2003/05/soap-envelope" xmlns:tds="http://www.onvif.org/ver10/device/wsdl">
  <soap:Body>
    <tds:SetSystemDateAndTimeResponse/>
  </soap:Body>
</soap:Envelope>"""

    elif "GetCapabilities" in action or "GetCapabilities" in body_str:
        xml_response = f"""<?xml version="1.0" encoding="utf-8"?>
<soap:Envelope xmlns:soap="http://www.w3.org/2003/05/soap-envelope" xmlns:tds="http://www.onvif.org/ver10/device/wsdl" xmlns:tt="http://www.onvif.org/ver10/schema">
  <soap:Body>
    <tds:GetCapabilitiesResponse>
      <tds:Capabilities>
        <tt:Device>
          <tt:XAddr>http://{host_ip}:{port}/onvif/device_service</tt:XAddr>
        </tt:Device>
        <tt:Media>
          <tt:XAddr>http://{host_ip}:{port}/onvif/media_service</tt:XAddr>
          <tt:StreamingCapabilities>
            <tt:RTP_RTSP_TCP>true</tt:RTP_RTSP_TCP>
          </tt:StreamingCapabilities>
        </tt:Media>
      </tds:Capabilities>
    </tds:GetCapabilitiesResponse>
  </soap:Body>
</soap:Envelope>"""

    elif "GetVideoSources" in action or "GetVideoSources" in body_str:
        xml_response = f"""<?xml version="1.0" encoding="utf-8"?>
<soap:Envelope xmlns:soap="http://www.w3.org/2003/05/soap-envelope" xmlns:trt="http://www.onvif.org/ver10/media/wsdl" xmlns:tt="http://www.onvif.org/ver10/schema">
  <soap:Body>
    <trt:GetVideoSourcesResponse>
      <trt:VideoSources token="vs_token">
        <tt:Framerate>15</tt:Framerate>
        <tt:Resolution>
          <tt:Width>{width}</tt:Width>
          <tt:Height>{height}</tt:Height>
        </tt:Resolution>
      </trt:VideoSources>
    </trt:GetVideoSourcesResponse>
  </soap:Body>
</soap:Envelope>"""

    elif "GetProfiles" in action or "GetProfiles" in body_str:
        xml_response = f"""<?xml version="1.0" encoding="utf-8"?>
<soap:Envelope xmlns:soap="http://www.w3.org/2003/05/soap-envelope" xmlns:trt="http://www.onvif.org/ver10/media/wsdl" xmlns:tt="http://www.onvif.org/ver10/schema">
  <soap:Body>
    <trt:GetProfilesResponse>
      <trt:Profiles token="main_stream">
        <tt:Name>MainStream</tt:Name>
        <tt:VideoSourceConfiguration token="vsc_token">
          <tt:Name>VideoSourceConfig</tt:Name>
          <tt:UseCount>1</tt:UseCount>
          <tt:SourceToken>vs_token</tt:SourceToken>
          <tt:Bounds x="0" y="0" width="{width}" height="{height}"/>
        </tt:VideoSourceConfiguration>
        <tt:VideoEncoderConfiguration token="encoder_hq_config_token">
          <tt:Name>HqConfiguration</tt:Name>
          <tt:UseCount>1</tt:UseCount>
          <tt:Encoding>H264</tt:Encoding>
          <tt:Resolution><tt:Width>{width}</tt:Width><tt:Height>{height}</tt:Height></tt:Resolution>
          <tt:RateControl><tt:FrameRateLimit>15</tt:FrameRateLimit></tt:RateControl>
        </tt:VideoEncoderConfiguration>
      </trt:Profiles>
      <trt:Profiles token="sub_stream">
        <tt:Name>SubStream</tt:Name>
        <tt:VideoSourceConfiguration token="vsc_token">
          <tt:Name>VideoSourceConfig</tt:Name>
          <tt:UseCount>1</tt:UseCount>
          <tt:SourceToken>vs_token</tt:SourceToken>
          <tt:Bounds x="0" y="0" width="640" height="360"/>
        </tt:VideoSourceConfiguration>
        <tt:VideoEncoderConfiguration token="encoder_lq_config_token">
          <tt:Name>LqConfiguration</tt:Name>
          <tt:UseCount>1</tt:UseCount>
          <tt:Encoding>H264</tt:Encoding>
          <tt:Resolution><tt:Width>640</tt:Width><tt:Height>360</tt:Height></tt:Resolution>
          <tt:RateControl><tt:FrameRateLimit>15</tt:FrameRateLimit></tt:RateControl>
        </tt:VideoEncoderConfiguration>
      </trt:Profiles>
    </trt:GetProfilesResponse>
  </soap:Body>
</soap:Envelope>"""

    elif "GetVideoEncoderConfiguration" in action or "GetVideoEncoderConfiguration" in body_str:
        is_sub = "encoder_lq_config_token" in body_str or "sub_stream" in body_str
        cfg_token = "encoder_lq_config_token" if is_sub else "encoder_hq_config_token"
        cfg_name = "LqConfiguration" if is_sub else "HqConfiguration"
        w = 640 if is_sub else width
        h = 360 if is_sub else height

        xml_response = f"""<?xml version="1.0" encoding="utf-8"?>
<soap:Envelope xmlns:soap="http://www.w3.org/2003/05/soap-envelope" xmlns:trt="http://www.onvif.org/ver10/media/wsdl" xmlns:tt="http://www.onvif.org/ver10/schema">
  <soap:Body>
    <trt:GetVideoEncoderConfigurationResponse>
      <trt:VideoEncoderConfiguration token="{cfg_token}">
        <tt:Name>{cfg_name}</tt:Name>
        <tt:UseCount>1</tt:UseCount>
        <tt:Encoding>H264</tt:Encoding>
        <tt:Resolution><tt:Width>{w}</tt:Width><tt:Height>{h}</tt:Height></tt:Resolution>
        <tt:Quality>4</tt:Quality>
        <tt:RateControl><tt:FrameRateLimit>15</tt:FrameRateLimit><tt:BitrateLimit>2048</tt:BitrateLimit></tt:RateControl>
      </trt:VideoEncoderConfiguration>
    </trt:GetVideoEncoderConfigurationResponse>
  </soap:Body>
</soap:Envelope>"""

    elif "GetVideoEncoderConfigurationOptions" in action or "GetVideoEncoderConfigurationOptions" in body_str:
        xml_response = f"""<?xml version="1.0" encoding="utf-8"?>
<soap:Envelope xmlns:soap="http://www.w3.org/2003/05/soap-envelope" xmlns:trt="http://www.onvif.org/ver10/media/wsdl" xmlns:tt="http://www.onvif.org/ver10/schema">
  <soap:Body>
    <trt:GetVideoEncoderConfigurationOptionsResponse>
      <trt:Options>
        <tt:QualityRange><tt:Min>1</tt:Min><tt:Max>5</tt:Max></tt:QualityRange>
        <tt:H264>
          <tt:ResolutionsAvailable>
            <tt:Width>{width}</tt:Width><tt:Height>{height}</tt:Height>
          </tt:ResolutionsAvailable>
          <tt:GovLengthRange><tt:Min>1</tt:Min><tt:Max>60</tt:Max></tt:GovLengthRange>
          <tt:FrameRateRange><tt:Min>1</tt:Min><tt:Max>30</tt:Max></tt:FrameRateRange>
          <tt:EncodingIntervalRange><tt:Min>1</tt:Min><tt:Max>1</tt:Max></tt:EncodingIntervalRange>
          <tt:H264ProfilesSupported>Main</tt:H264ProfilesSupported>
        </tt:H264>
      </trt:Options>
    </trt:GetVideoEncoderConfigurationOptionsResponse>
  </soap:Body>
</soap:Envelope>"""

    elif "GetOSDOptions" in action or "GetOSDOptions" in body_str:
        xml_response = """<?xml version="1.0" encoding="utf-8"?>
<soap:Envelope xmlns:soap="http://www.w3.org/2003/05/soap-envelope" xmlns:trt="http://www.onvif.org/ver10/media/wsdl" xmlns:tt="http://www.onvif.org/ver10/schema">
  <soap:Body>
    <trt:GetOSDOptionsResponse>
      <trt:OSDOptions>
        <tt:MaximumNumberOfOSDs>
          <tt:Text>0</tt:Text>
          <tt:Image>0</tt:Image>
          <tt:Extended>0</tt:Extended>
        </tt:MaximumNumberOfOSDs>
      </trt:OSDOptions>
    </trt:GetOSDOptionsResponse>
  </soap:Body>
</soap:Envelope>"""

    elif "GetOSDs" in action or "GetOSDs" in body_str:
        xml_response = """<?xml version="1.0" encoding="utf-8"?>
<soap:Envelope xmlns:soap="http://www.w3.org/2003/05/soap-envelope" xmlns:trt="http://www.onvif.org/ver10/media/wsdl">
  <soap:Body>
    <trt:GetOSDsResponse/>
  </soap:Body>
</soap:Envelope>"""

    elif "GetCompatibleVideoAnalyticsConfigurations" in action or "GetCompatibleVideoAnalyticsConfigurations" in body_str:
        xml_response = """<?xml version="1.0" encoding="utf-8"?>
<soap:Envelope xmlns:soap="http://www.w3.org/2003/05/soap-envelope" xmlns:trt="http://www.onvif.org/ver10/media/wsdl">
  <soap:Body>
    <trt:GetCompatibleVideoAnalyticsConfigurationsResponse/>
  </soap:Body>
</soap:Envelope>"""

    elif "GetSnapshotUri" in action or "GetSnapshotUri" in body_str:
        xml_response = f"""<?xml version="1.0" encoding="utf-8"?>
<soap:Envelope xmlns:soap="http://www.w3.org/2003/05/soap-envelope" xmlns:trt="http://www.onvif.org/ver10/media/wsdl" xmlns:tt="http://www.onvif.org/ver10/schema">
  <soap:Body>
    <trt:GetSnapshotUriResponse>
      <trt:MediaUri>
        <tt:Uri>http://{host_ip}:{port}/snapshot.jpg</tt:Uri>
        <tt:InvalidAfterConnect>false</tt:InvalidAfterConnect>
        <tt:InvalidAfterReboot>false</tt:InvalidAfterReboot>
        <tt:Timeout>PT60S</tt:Timeout>
      </trt:MediaUri>
    </trt:GetSnapshotUriResponse>
  </soap:Body>
</soap:Envelope>"""

    elif "GetStreamUri" in action or "GetStreamUri" in body_str:
        target_rtsp = lq_rtsp if "sub_stream" in body_str else hq_rtsp
        xml_response = f"""<?xml version="1.0" encoding="utf-8"?>
<soap:Envelope xmlns:soap="http://www.w3.org/2003/05/soap-envelope" xmlns:trt="http://www.onvif.org/ver10/media/wsdl" xmlns:tt="http://www.onvif.org/ver10/schema">
  <soap:Body>
    <trt:GetStreamUriResponse>
      <trt:MediaUri>
        <tt:Uri>{target_rtsp}</tt:Uri>
        <tt:InvalidAfterConnect>false</tt:InvalidAfterConnect>
        <tt:InvalidAfterReboot>false</tt:InvalidAfterReboot>
        <tt:Timeout>PT60S</tt:Timeout>
      </trt:MediaUri>
    </trt:GetStreamUriResponse>
  </soap:Body>
</soap:Envelope>"""

    elif "SetSynchronizationPoint" in action or "SetSynchronizationPoint" in body_str:
        xml_response = """<?xml version="1.0" encoding="utf-8"?>
<soap:Envelope xmlns:soap="http://www.w3.org/2003/05/soap-envelope" xmlns:trt="http://www.onvif.org/ver10/media/wsdl">
  <soap:Body>
    <trt:SetSynchronizationPointResponse/>
  </soap:Body>
</soap:Envelope>"""

    else:
        print(f"[ONVIF] Unhandled Action: {action}")
        xml_response = f"""<?xml version="1.0" encoding="utf-8"?>
<soap:Envelope xmlns:soap="http://www.w3.org/2003/05/soap-envelope">
  <soap:Body>
    <soap:Fault>
      <faultcode>Client</faultcode>
      <faultstring>Not Implemented: {action}</faultstring>
    </soap:Fault>
  </soap:Body>
</soap:Envelope>"""

    return Response(content=xml_response, media_type="application/soap+xml")
